# Copy to .env and fill values
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
FROM_EMAIL=notifications@instadocmetrics.com

# Optional overrides for department destination
EMAIL_GENERAL=hello@instadocmetrics.com
EMAIL_SALES=sales@instadocmetrics.com
EMAIL_SUPPORT=support@instadocmetrics.com
EMAIL_PARTNERS=partners@instadocmetrics.com